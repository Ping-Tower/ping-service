RABBITMQ_HOST=broker
RABBITMQ_PORT=5672
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=CHANGE_ME_RABBITMQ_PASSWORD
RABBITMQ_VHOST=/
RABBITMQ_SERVER_EVENTS_QUEUE=q.ping-service.server-events
